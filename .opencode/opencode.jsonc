{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "worktree": { "directory": "../fleck-home-hub-worktrees" },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "subagent", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" }
  ],
  // Global rules are appended after project rules and the last match wins, so a user-level
  // `shell: * ask` would override any project-level allow. Agent rules are appended last, so the
  // routine allowlist lives under the build agent. There is deliberately no `shell: *` rule here;
  // anything not listed falls back to ask. Denies and asks come after the allows they override.
  "agents": {
    "build": {
      "permissions": [
        { "action": "external_directory", "resource": "$HOME/development/github/fleck-home-hub/*", "effect": "allow" },
        { "action": "external_directory", "resource": "$HOME/development/github/fleck-home-hub-worktrees/*", "effect": "allow" },

        { "action": "shell", "resource": "pwd", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "grep *", "effect": "allow" },
        { "action": "shell", "resource": "sed -n *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "tail *", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "which *", "effect": "allow" },
        { "action": "shell", "resource": "command -v *", "effect": "allow" },

        // Fixed-table task dispatcher: only known tasks and validated test paths.
        { "action": "shell", "resource": "./scripts/dev.sh *", "effect": "allow" },
        // Named mise tasks and the project's own test runners. These run repo-defined code, like
        // dev.sh does; arbitrary `mise exec`, `mise x` and `pnpm exec <anything>` stay on ask.
        { "action": "shell", "resource": "mise run test *", "effect": "allow" },
        { "action": "shell", "resource": "mise run e2e *", "effect": "allow" },
        { "action": "shell", "resource": "mise run typecheck *", "effect": "allow" },
        { "action": "shell", "resource": "mise run lint *", "effect": "allow" },
        { "action": "shell", "resource": "mise run build *", "effect": "allow" },
        { "action": "shell", "resource": "mise run verify *", "effect": "allow" },
        { "action": "shell", "resource": "mise run doctor *", "effect": "allow" },
        { "action": "shell", "resource": "mise run agent-policy *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm vitest run *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec vitest run *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec playwright test *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec svelte-kit sync", "effect": "allow" },
        // The same test runners through the mise wrapper, which agents reach for out of habit. The
        // wrapper itself runs any command, so only these exact forms are allowed.
        { "action": "shell", "resource": "./scripts/run-with-mise.sh pnpm vitest run *", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/run-with-mise.sh pnpm exec vitest run *", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/run-with-mise.sh pnpm exec playwright test *", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/run-with-mise.sh pnpm exec svelte-kit sync", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/run-with-mise.sh pnpm run test *", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/run-with-mise.sh pnpm run e2e *", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/run-with-mise.sh pnpm run lint *", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/run-with-mise.sh pnpm run typecheck *", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/run-with-mise.sh pnpm run build *", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/sync-main.sh", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/push-branch.sh", "effect": "allow" },

        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
        { "action": "shell", "resource": "git branch *", "effect": "allow" },
        { "action": "shell", "resource": "git switch *", "effect": "allow" },
        { "action": "shell", "resource": "git worktree add *", "effect": "allow" },
        { "action": "shell", "resource": "git worktree list *", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
        { "action": "shell", "resource": "git grep *", "effect": "allow" },
        { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
        { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
        { "action": "shell", "resource": "git add *", "effect": "allow" },
        { "action": "shell", "resource": "git commit *", "effect": "allow" },
        { "action": "shell", "resource": "git fetch *", "effect": "allow" },
        { "action": "shell", "resource": "git push *", "effect": "allow" },
        { "action": "shell", "resource": "git -C * status *", "effect": "allow" },
        { "action": "shell", "resource": "git -C * diff *", "effect": "allow" },
        { "action": "shell", "resource": "git -C * log *", "effect": "allow" },
        { "action": "shell", "resource": "git -C * show *", "effect": "allow" },
        { "action": "shell", "resource": "git -C * worktree list *", "effect": "allow" },

        { "action": "shell", "resource": "gh issue *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr *", "effect": "allow" },

        // Overrides of the allows above.
        { "action": "shell", "resource": "find * -delete*", "effect": "ask" },
        { "action": "shell", "resource": "find * -exec*", "effect": "ask" },
        { "action": "shell", "resource": "find * -ok*", "effect": "ask" },
        { "action": "shell", "resource": "cat *.env*", "effect": "ask" },
        { "action": "shell", "resource": "cat *.db*", "effect": "ask" },
        { "action": "shell", "resource": "git branch -d *", "effect": "ask" },
        { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
        { "action": "shell", "resource": "git branch --delete *", "effect": "ask" },
        { "action": "shell", "resource": "git push --force *", "effect": "deny" },
        { "action": "shell", "resource": "git push * --force *", "effect": "deny" },
        { "action": "shell", "resource": "git push * +*", "effect": "deny" },
        { "action": "shell", "resource": "git push --delete *", "effect": "deny" },
        { "action": "shell", "resource": "git push * --delete *", "effect": "deny" },
        { "action": "shell", "resource": "git push * :*", "effect": "deny" },
        { "action": "shell", "resource": "git push --tags*", "effect": "deny" },
        { "action": "shell", "resource": "git push * --tags*", "effect": "deny" },
        { "action": "shell", "resource": "git push --mirror*", "effect": "deny" },
        { "action": "shell", "resource": "git push * --mirror*", "effect": "deny" },
        { "action": "shell", "resource": "git push --force-with-lease *", "effect": "ask" },
        { "action": "shell", "resource": "git push * --force-with-lease", "effect": "ask" },
        { "action": "shell", "resource": "git push * --force-with-lease *", "effect": "ask" },
        { "action": "shell", "resource": "gh pr merge *", "effect": "deny" },
        { "action": "shell", "resource": "gh pr review *--approve*", "effect": "deny" },
        { "action": "shell", "resource": "gh pr review -a*", "effect": "deny" },
        { "action": "shell", "resource": "gh pr review * -a*", "effect": "deny" },
        { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
        { "action": "shell", "resource": "git clean *", "effect": "deny" },
        { "action": "shell", "resource": "sudo *", "effect": "deny" },
        { "action": "shell", "resource": "pkill *", "effect": "deny" },
        { "action": "shell", "resource": "killall *", "effect": "deny" },
        { "action": "shell", "resource": "tailscale *", "effect": "deny" }
      ]
    }
  },
  "policies": [
    { "action": "tool.use", "resource": "shell:gh pr merge *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh pr review * --approve*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push --force *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reset --hard *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git clean *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pkill *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:killall *", "effect": "deny" }
  ]
}
