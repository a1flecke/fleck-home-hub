{
  "fleck-home-hub-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|view_file|edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- node ./hooks/guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
