{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(hub.conf)",
      "Read(**/hub.conf)",
      "Read(**/*.sqlite)",
      "Read(**/*.sqlite3)",
      "Read(**/*.sqlite-wal)",
      "Read(**/*.sqlite-shm)",
      "Read(**/*.sqlite-journal)",
      "Read(**/*.db)",
      "Read(**/*.db-wal)",
      "Read(**/*.db-shm)",
      "Read(**/*.db-journal)",
      "Read(**/*.age)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(~/.config/opencode/service.json)"
    ],
    "ask": ["Bash(tailscale:*)", "Edit(~/.config/opencode/**)", "Write(~/.config/opencode/**)"]
  },
  "hooks": {
    "PreToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "mise exec -- node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"", "timeout": 10 }] }]
  }
}
