#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
mise exec -- node scripts/pre-push-guard.mjs
# Git exports repository-local variables to hooks; do not leak them into tests
# that create and inspect independent repositories.
for name in $(git rev-parse --local-env-vars); do
  unset "$name"
done
exec ./scripts/verify-before-push.sh
